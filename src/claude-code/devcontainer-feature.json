{
    "id": "claude-code",
    "version": "0.0.1",
    "name": "Claude Code CLI",
    "description": "Installs the Claude Code CLI from Anthropic's official native releases.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/claude-code",
    "keywords": [
        "claude",
        "claude-code",
        "ai",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "stable",
                "2.1.329"
            ],
            "default": "latest",
            "description": "Claude Code version to install: latest, stable, or an exact version such as 2.1.329."
        }
    },
    "containerEnv": {
        "DISABLE_AUTOUPDATER": "1"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code"
            ]
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
