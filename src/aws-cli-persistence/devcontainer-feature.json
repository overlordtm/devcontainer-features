{
    "id": "aws-cli-persistence",
    "version": "0.0.3",
    "name": "AWS CLI Persistence",
    "description": "Persists aws (AWS CLI v2) configuration, credentials, and SSO sessions across container rebuilds using a Docker volume.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/aws-cli-persistence",
    "keywords": [
        "aws",
        "amazon",
        "persistence",
        "volume"
    ],
    "mounts": [
        {
            "source": "${localWorkspaceFolderBasename}-${devcontainerId}-aws-cli-state",
            "target": "/dc/aws",
            "type": "volume"
        }
    ],
    "onCreateCommand": {
        "aws-cli-persistence": "/usr/local/share/aws-cli-persistence/oncreate.sh"
    },
    "installsAfter": [
        "ghcr.io/overlordtm/devcontainer-features/aws-cli",
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
