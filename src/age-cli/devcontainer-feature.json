{
    "id": "age-cli",
    "version": "0.0.2",
    "name": "age CLI",
    "description": "Installs the age file encryption CLI (age and age-keygen) from official GitHub releases.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/age-cli",
    "keywords": [
        "age",
        "encryption",
        "security",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "1.3.2",
                "latest"
            ],
            "default": "1.3.2",
            "description": "Version of age to install."
        },
        "hash": {
            "type": "string",
            "proposals": [
                "auto",
                "disabled"
            ],
            "default": "auto",
            "description": "SHA-256/SHA-512 checksum for the downloaded artifact. Use 'auto' to look it up in the built-in version map, or 'disabled' to skip verification."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
