{
    "id": "gitleaks-cli",
    "version": "0.0.2",
    "name": "Gitleaks CLI (gitleaks)",
    "description": "Installs the Gitleaks secret scanning CLI (gitleaks) from official GitHub releases.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/gitleaks-cli",
    "keywords": [
        "gitleaks",
        "secrets",
        "security",
        "secret-scanning",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "8.30.1",
                "latest"
            ],
            "default": "8.30.1",
            "description": "Version of gitleaks to install."
        },
        "hash": {
            "type": "string",
            "proposals": [
                "auto",
                "disabled"
            ],
            "default": "auto",
            "description": "SHA-256/SHA-512 checksum for the downloaded artifact. Use 'auto' to look it up in the built-in version map, or 'disabled' to skip verification."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
