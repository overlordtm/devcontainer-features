{
    "id": "gh-cli",
    "version": "0.0.1",
    "name": "GitHub CLI (gh)",
    "description": "Installs the GitHub CLI (gh) from official GitHub releases.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/gh-cli",
    "keywords": [
        "github",
        "gh",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "2.105.0",
                "latest"
            ],
            "default": "2.105.0",
            "description": "Version of gh to install."
        },
        "hash": {
            "type": "string",
            "proposals": [
                "auto",
                "disabled"
            ],
            "default": "auto",
            "description": "SHA-256/SHA-512 checksum for the downloaded artifact. Use 'auto' to look it up in the built-in version map, or 'disabled' to skip verification."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
