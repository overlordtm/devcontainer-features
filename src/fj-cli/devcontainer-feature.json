{
    "id": "fj-cli",
    "version": "1.0.0",
    "name": "Forgejo CLI (fj)",
    "description": "Installs fj, the Forgejo and Gitea command-line client, from official releases.",
    "keywords": [
        "forgejo",
        "gitea",
        "fj",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "0.7.0"
            ],
            "default": "latest",
            "description": "Version of fj to install."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
