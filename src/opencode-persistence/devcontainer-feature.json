{
    "id": "opencode-persistence",
    "version": "0.0.3",
    "name": "OpenCode Persistence",
    "description": "Persists OpenCode config, authentication, and session data across container rebuilds using a Docker volume.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/opencode-persistence",
    "keywords": [
        "opencode",
        "ai",
        "persistence",
        "volume"
    ],
    "mounts": [
        {
            "source": "${localWorkspaceFolderBasename}-${devcontainerId}-opencode-state",
            "target": "/dc/opencode",
            "type": "volume"
        }
    ],
    "onCreateCommand": {
        "opencode-persistence": "/usr/local/share/opencode-persistence/oncreate.sh"
    },
    "installsAfter": [
        "ghcr.io/overlordtm/devcontainer-features/opencode-cli",
        "ghcr.io/jsburckhardt/devcontainer-features/opencode",
        "ghcr.io/devcontainers-extra/features/opencode",
        "ghcr.io/temeteke/devcontainer-features/opencode",
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
