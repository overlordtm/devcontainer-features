{
    "id": "aws-cli",
    "version": "0.0.1",
    "name": "AWS CLI (aws)",
    "description": "Installs the AWS CLI v2 (aws) from official AWS release bundles.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/aws-cli",
    "keywords": [
        "aws",
        "amazon",
        "amazon-web-services",
        "cloud",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "2.42.0",
                "latest"
            ],
            "default": "2.42.0",
            "description": "Version of the AWS CLI v2 to install."
        },
        "hash": {
            "type": "string",
            "proposals": [
                "auto",
                "disabled"
            ],
            "default": "auto",
            "description": "SHA-256/SHA-512 checksum for the downloaded artifact. Use 'auto' to look it up in the built-in version map, or 'disabled' to skip verification."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
