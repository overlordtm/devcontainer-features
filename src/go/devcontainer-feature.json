{
    "id": "go",
    "version": "0.0.1",
    "name": "Go (golang)",
    "description": "Installs the Go programming language toolchain from official upstream releases.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/go",
    "keywords": [
        "go",
        "golang",
        "programming-language",
        "compiler",
        "toolchain"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "1.27.4",
                "latest"
            ],
            "default": "1.27.4",
            "description": "Version of Go to install."
        },
        "hash": {
            "type": "string",
            "proposals": [
                "auto",
                "disabled"
            ],
            "default": "auto",
            "description": "SHA-256/SHA-512 checksum for the downloaded archive. Use 'auto' to look it up in the built-in version map, or 'disabled' to skip verification."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
