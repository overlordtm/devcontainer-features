{
    "id": "gcx-cli-persistence",
    "version": "0.0.1",
    "name": "Grafana CLI Persistence",
    "description": "Persists gcx (Grafana CLI) configuration across container rebuilds using a Docker volume.",
    "documentationURL": "https://github.com/overlordtm/devcontainer-features/tree/main/src/gcx-cli-persistence",
    "keywords": [
        "grafana",
        "gcx",
        "persistence",
        "volume"
    ],
    "mounts": [
        {
            "source": "gcx-cli-state",
            "target": "/dc/gcx",
            "type": "volume"
        }
    ],
    "onCreateCommand": {
        "gcx-cli-persistence": "/usr/local/share/gcx-cli-persistence/oncreate.sh"
    },
    "installsAfter": [
        "ghcr.io/overlordtm/devcontainer-features/gcx-cli",
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
